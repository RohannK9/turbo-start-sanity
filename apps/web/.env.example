NEXT_PUBLIC_SANITY_PROJECT_ID=lw22l8jn
NEXT_PUBLIC_SANITY_DATASET=production
# Pin API behavior across local development and deployment.
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-18
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Shared rate limit for the public newsletter endpoint. Keep both server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# FAQ ask box. Endpoint: a Sanity Context MCP URL; token: an organisation Context Viewer token.
# Models run through Vercel AI Gateway: set a key, or run `vercel env pull` for an OIDC token.
AI_GATEWAY_API_KEY=
SANITY_CONTEXT_ENDPOINT=
SANITY_CONTEXT_TOKEN=

# Presentation e2e only. Editor-role token; falls back to SANITY_API_WRITE_TOKEN.
SANITY_E2E_SESSION_TOKEN=
# Dataset the Presentation suite runs against. Defaults to `e2e`; it publishes
# into the real navbar/footer/settings, so never point it at production.
SANITY_E2E_DATASET=
# Set when apps/studio/functions are deployed; skips the redirect test if not.
SANITY_E2E_FUNCTIONS_DEPLOYED=

# Algolia: admin key is server-only; the search key needs ONLY the search ACL.
ALGOLIA_APP_ID=988QB05RUC
ALGOLIA_INDEX_NAME=blog_posts
ALGOLIA_ADMIN_API_KEY=
ALGOLIA_SEARCH_API_KEY=
# Generate with: openssl rand -hex 32. Use as the webhook's Authorization bearer token.
SANITY_ALGOLIA_WEBHOOK_SECRET=
